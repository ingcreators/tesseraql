{
  "TesseraQL query-json route": {
    "prefix": "tql-query-json",
    "description": "A read route returning JSON from a 2-way SQL file (docs/reference-yaml-surface.md)",
    "body": [
      "version: tesseraql/v1",
      "id: ${1:app.search}",
      "kind: route",
      "recipe: query-json",
      "",
      "input:",
      "  ${2:q}:",
      "    type: string",
      "    required: false",
      "    maxLength: 200",
      "",
      "security:",
      "  auth: ${3|bearer,browser,none|}",
      "  policy: ${4:app.read}",
      "",
      "sql:",
      "  file: ${5:search}.sql",
      "  mode: query",
      "  params:",
      "    ${2:q}: query.${2:q}",
      "",
      "response:",
      "  json:",
      "    status: 200",
      "    body:",
      "      data: sql.rows",
      "      meta:",
      "        count: sql.rowCount"
    ]
  },
  "TesseraQL query-html route": {
    "prefix": "tql-query-html",
    "description": "A read route rendering HTML through a declarative view (docs/declarative-views.md)",
    "body": [
      "version: tesseraql/v1",
      "id: ${1:app.page}",
      "kind: route",
      "recipe: query-html",
      "",
      "input:",
      "  ${2:q}:",
      "    type: string",
      "    required: false",
      "    maxLength: 200",
      "",
      "security:",
      "  auth: browser",
      "  policy: ${3:app.read}",
      "",
      "sql:",
      "  file: ${4:search}.sql",
      "  mode: query",
      "  params:",
      "    ${2:q}: query.${2:q}",
      "",
      "response:",
      "  html:",
      "    view: ${5:items}"
    ]
  },
  "TesseraQL command-json route": {
    "prefix": "tql-command",
    "description": "A transactional write route: one transaction, field-level constraint errors (docs/transactional-writes.md)",
    "body": [
      "version: tesseraql/v1",
      "id: ${1:app.create}",
      "kind: route",
      "recipe: command-json",
      "",
      "input:",
      "  ${2:name}:",
      "    type: string",
      "    required: true",
      "    maxLength: 200",
      "",
      "inputPolicy:",
      "  unknownFields: reject",
      "",
      "security:",
      "  auth: ${3|browser,bearer|}",
      "  policy: ${4:app.write}",
      "  csrf: true",
      "",
      "steps:",
      "  ${5:record}:",
      "    file: ${6:insert}.sql",
      "    mode: update",
      "    keys: [id]",
      "    params:",
      "      ${2:name}: params.${2:name}",
      "",
      "response:",
      "  redirect:",
      "    location: ${7:/items}/{steps.${5:record}.keys.id}"
    ]
  },
  "TesseraQL list view": {
    "prefix": "tql-view-list",
    "description": "A declarative list view: sortable columns, live search (docs/declarative-views.md)",
    "body": [
      "version: tesseraql/v1",
      "id: ${1:items}",
      "kind: view",
      "recipe: list",
      "title: ${2:Items}",
      "search: ${3:q}",
      "columns:",
      "  - name: ${4:id}",
      "    sortable: true",
      "  - name: ${5:name}",
      "    sortable: true"
    ]
  },
  "TesseraQL dashboard view": {
    "prefix": "tql-view-dashboard",
    "description": "A declarative dashboard: stat + kit chart + table panels (docs/declarative-views.md)",
    "body": [
      "version: tesseraql/v1",
      "id: ${1:overview}",
      "kind: view",
      "recipe: dashboard",
      "title: ${2:Overview}",
      "panels:",
      "  - { type: stat, source: sql, column: ${3:total}, title: ${4:Total} }",
      "  - type: chart",
      "    chart: ${5|bar,line,area,combo,bar-stacked,bar-grouped,scatter|}",
      "    source: ${6:by_category}",
      "    title: ${7:By category}",
      "    x: ${8:label}",
      "    yLabel: ${9:units}",
      "    series:",
      "      - { column: ${10:value}, label: ${11:Value} }",
      "  - type: table",
      "    source: ${12:recent}",
      "    title: ${13:Recent}"
    ]
  },
  "TesseraQL chart panel": {
    "prefix": "tql-chart-panel",
    "description": "A dashboard chart panel in the kit's data-hc-chart vocabulary - multi-series via series:, mark: only under chart: combo (docs/declarative-views.md, lint TQL-VIEW-3313)",
    "body": [
      "- type: chart",
      "  chart: ${1|bar,line,area,combo,bar-stacked,bar-grouped,scatter|}",
      "  source: ${2:by_category}",
      "  title: ${3:By category}",
      "  x: ${4:label}",
      "  xType: ${5|category,number,date|}",
      "  yLabel: ${6:units}",
      "  series:",
      "    - { column: ${7:stock}, label: ${8:In stock} }",
      "    - { column: ${9:reserved}, label: ${10:Reserved} }"
    ]
  },
  "TesseraQL export step": {
    "prefix": "tql-export-step",
    "description": "A file-producing pipeline step: the export vocabulary on the job's datasource; publishes step.<id>.transferId/rows/filename (docs/jobs.md, lint TQL-YAML-1041)",
    "body": [
      "pipeline:",
      "  - id: ${1:report}",
      "    export:",
      "      format: ${2|csv,excel,pdf|}",
      "      filename: ${3:report}-{batch.businessDate}.${4:csv}",
      "      sql: { file: ${5:report}.sql, mode: query }",
      "      columns:",
      "        - { name: ${6:category}, header: ${7:Category} }",
      "        - { name: ${8:total}, header: ${9:Total}, type: number, format: \"#,##0\" }",
      "  # the produced file lands on the ops console's transfers page;",
      "  # a follow-up step can carry the pointer:",
      "  - id: ${10:announce}",
      "    notify:",
      "      channel: ${11:reports}",
      "      payload:",
      "        rows: step.${1:report}.rows",
      "        transferId: step.${1:report}.transferId",
      ""
    ]
  },
  "TesseraQL SQL test case": {
    "prefix": "tql-test",
    "description": "A declarative SQL suite case (docs/getting-started.md)",
    "body": [
      "version: tesseraql/v1",
      "tests:",
      "  - name: ${1:the search returns the seeded row}",
      "    sql:",
      "      file: ${2:web/api/items/search.sql}",
      "    params:",
      "      ${3:q}: \"${4}\"",
      "    expect:",
      "      rowCount: ${5:1}"
    ]
  },
  "TesseraQL approval workflow": {
    "prefix": "tql-workflow",
    "description": "An approval workflow with a guarded pair and a one-action dispatch (docs/approval-workflow.md)",
    "body": [
      "version: tesseraql/v1",
      "id: ${1:purchase_request}",
      "kind: workflow",
      "document: { type: ${1:purchase_request}, table: ${2:purchase_requests}, key: ${3:id} }",
      "http: { basePath: ${4:/api/requests} }",
      "security: { auth: bearer }",
      "initial: draft",
      "states:",
      "  - { id: draft, type: initial }",
      "  - { id: submitted }",
      "  - { id: approved, type: terminal }",
      "transitions:",
      "  - id: submit",
      "    from: draft",
      "    to: submitted",
      "    guard: \"document.${5:amount} > 0\"",
      "    command: ${6:submit.sql}",
      "  - id: approve",
      "    from: submitted",
      "    to: approved",
      "    command: ${7:approve.sql}"
    ]
  },
  "TesseraQL transition test case": {
    "prefix": "tql-test-transition",
    "description": "A workflow-transition suite case (docs/testing.md)",
    "body": [
      "  - name: ${1:submitting advances the document}",
      "    transition:",
      "      workflow: ${2:purchase_request}",
      "      key: ${3:PR-1}",
      "      id: ${4:submit}",
      "    expect:",
      "      rows:",
      "        - from: ${5:draft}",
      "          to: ${6:submitted}"
    ]
  },
  "TesseraQL dispatch test case": {
    "prefix": "tql-test-dispatch",
    "description": "A one-action dispatch suite case - the selector asserted as data (docs/transition-engine.md)",
    "body": [
      "  - name: ${1:the dispatch fires the lane the guard admits}",
      "    dispatch:",
      "      workflow: ${2:purchase_request}",
      "      key: ${3:PR-1}",
      "      id: ${4:submit_decision}",
      "    expect:",
      "      rows:",
      "        - transition: ${5:approve}",
      "          to: ${6:approved}"
    ]
  },
  "TesseraQL business-day calendar": {
    "prefix": "tql-calendar",
    "description": "A calendars/ shared definition: weekend plus holidays as dates: or a table-backed source: (docs/jobs.md)",
    "body": [
      "version: tesseraql/v1",
      "",
      "calendars:",
      "  ${1:jp-banking}:",
      "    weekend: [saturday, sunday]",
      "    holidays:",
      "      dates: [${2:2026-01-01}]",
      "      # or table-backed, read at fire time:",
      "      # source: { table: holidays, date: holiday_date, calendar: calendar_id }",
      ""
    ]
  },
  "TesseraQL calendar-gated schedule": {
    "prefix": "tql-job-schedule",
    "description": "A schedule under the daily-consider model: the cron considers, the calendar counts (docs/jobs.md)",
    "body": [
      "trigger:",
      "  schedule:",
      "    cron: \"${1:0 0 2 * * ?}\"",
      "    calendar: ${2:jp-banking}",
      "    ${3|runOn: business-day,runOn: first-business-day-of-month,runOn: last-business-day-of-month,dayOfMonth: 5|}",
      "    # dayOfMonth runs FOR the nominal date; add shift: previous-business-day to move back",
      ""
    ]
  },
  "TesseraQL chunk step": {
    "prefix": "tql-chunk-step",
    "description": "A restartable chunk step with the keyset reader contract - order by the key, resume after the checkpoint (docs/jobs.md)",
    "body": [
      "pipeline:",
      "  - id: ${1:revalue}",
      "    chunk:",
      "      reader: { file: ${2:unprocessed}.sql }",
      "      writer: { file: ${3:process-one}.sql }",
      "      key: ${4:id}",
      "      commitEvery: ${5:500}",
      "      onError: { skipLimit: ${6:0} }",
      "",
      "# ${2}.sql - the restart contract lives here (lint TQL-BATCH-4207/4208):",
      "#   select ${4}, ...",
      "#   from ${7:source_table}",
      "#   /*%if chunk.after != null */",
      "#   where ${4} > cast(/* chunk.after */ '0' as bigint)",
      "#   /*%end*/",
      "#   order by ${4}",
      "# ${3}.sql runs once per row; binds: row.* + batch.*",
      ""
    ]
  }
}
