# Each route folder is the complete unit: yml + colocated template.
# IAM admin console app (design ch. 10): served by the runtime as a mounted system app.
config/tesseraql.yml
web/_tesseraql/admin/applications/applications.html
web/_tesseraql/admin/applications/get.yml
web/_tesseraql/admin/applications/{name}/application.html
web/_tesseraql/admin/applications/{name}/get.yml
web/_tesseraql/admin/delegations/delegations.html
web/_tesseraql/admin/delegations/get.yml
web/_tesseraql/admin/users/get.yml
web/_tesseraql/admin/users/invite/post.yml
web/_tesseraql/admin/users/list.html
web/_tesseraql/admin/users/{id}/detail.html
web/_tesseraql/admin/users/{id}/disable/post.yml
web/_tesseraql/admin/users/{id}/enable/post.yml
web/_tesseraql/admin/users/{id}/get.yml
web/_tesseraql/admin/sessions/get.yml
web/_tesseraql/admin/sessions/revoke/post.yml
web/_tesseraql/admin/sessions/sessions.html
web/_tesseraql/admin/users/{id}/sessions/revoke-one/post.yml
web/_tesseraql/admin/users/{id}/sessions/revoke/post.yml
