{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.format.settings.url": "config/eclipse-formatter.xml",
  "java.format.settings.profile": "TesseraQL",
  "java.completion.importOrder": ["#"],
  "[java]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // The codebase carries no null annotations of its own; "automatic" would switch analysis
  // on because org.jspecify:jspecify reaches every module's test classpath through
  // junit-jupiter-api (its API is @NullMarked) and the runtime's compile classpath through
  // webjars-locator-lite, so every finding would be against those APIs and the JDK.
  // Re-derive with `./mvnw -o -q dependency:tree -Dincludes=org.jspecify`. The devcontainer
  // repeats this setting (.devcontainer/devcontainer.json); change both.
  "java.compile.nullAnalysis.mode": "disabled",
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "yaml.validate": true
}
