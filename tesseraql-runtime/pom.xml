<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tesseraql</groupId>
    <artifactId>tesseraql-parent</artifactId>
    <version>0.15.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tesseraql-runtime</artifactId>
  <name>Tesseraql Runtime</name>

  <properties>
    <surefire.forkCount>1C</surefire.forkCount>
  </properties>

  <dependencies>
    <!-- QR rendering for the TOTP enrollment page (docs/credential-lifecycle.md): zxing core
         only (the matrix); the SVG is assembled by QrSvg, so no imaging stack rides along. -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.4</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-compiler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-pipeline</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-operations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-identity</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Self-hosted browser libraries (design ch. 12, 50): served at version-less
         /assets/vendor/<webjar>/... paths so pages never load from a CDN and upgrades are a
         one-line version bump here. -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>htmx.org</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>hypermedia-components__core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>observablehq__plot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.webjars</groupId>
      <artifactId>webjars-locator-lite</artifactId>
    </dependency>
    <!-- Flyway-managed app schema migrations, run when an app is mounted (design ch. 31, 32). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-sqlserver</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <!-- Corporate identity — SCIM provisioning, SAML and OIDC sign-in — travels with the runtime
         (docs/module-channel.md decision 2). These three are first-party, add no third-party
         artifact to this closure (168 KB in total, and each one's own pom is guarded against
         growing one), and stay inert until configured: each is a RuntimeExtension whose
         enabled(AppConfig) is false without its configuration key, and tesseraql.plugins.allowlist
         gates classpath providers as well as plugin providers. Carrying them means an enterprise
         deployment configures SSO instead of adding jars to an image — which the deployment
         distribution has no supported way to do. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-scim</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-saml</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-oidc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The authorization server (docs/token-issuance.md): a framework surface of the stack,
         gated by the stack file's security.oauth.enabled — inert everywhere the graft does
         not reach. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-oauth</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Studio and the declarative test engine deliberately do NOT appear here: the workshop
         lives in tesseraql-studio-runtime, discovered through the RuntimeExtension SPI, so a
         deployment's runtime carries no test framework (docs/studio-shell.md structural
         decision 3, docs/runtime-footprint.md problem 2). The enforcer rule below is the
         boundary's guard. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-ops-ui</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-observability</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      The gateway's relay (docs/stack-architecture.md decision 13). Vert.x is already here through
      camel-platform-http-vertx, so this adds one jar at a version the runtime already resolves;
      its only transitive dependency is the vertx-core already on the classpath. A hand-rolled
      relay was measured on 2026-08-16 and lost chunked bodies outright, buffered event streams,
      and copied HTTP/2 pseudo-headers into HTTP/1.1 answers — see MultiAppGateway.
    -->
    <!--
      The runtime owns its HTTP server and router (docs/http-edge.md decision 1); they used to
      arrive through camel-platform-http-vertx, which no longer has anything to route.
    -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-http-proxy</artifactId>
    </dependency>
    <!--
      The components this runtime resolves, declared one by one rather than taken from the
      camel-core aggregate (slice 0). The list keeps shrinking as the campaign proceeds: direct
      and timer left with the pipelines and the schedules that used to need them
      (docs/camel-removal.md decisions 1 and 5), leaving the FTPS consumer's own. A component that
      is not on the classpath cannot be auto-discovered, refused, or exploited.
    -->
    <!--
      Quartz's cron expression, without Quartz's scheduler (docs/camel-removal.md decision 5).
      What makes a cron firing safe across replicas is that every node computes the same fire time
      and one of them wins the claim — CronExpression is that computation. The scheduler, its
      thread pool and its JDBC job store are not used, so c3p0 (which the job store brings, and
      which is a second connection pool in a runtime that declares its own) is excluded rather
      than shipped unused.
    -->
    <dependency>
      <groupId>org.quartz-scheduler</groupId>
      <artifactId>quartz</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.mchange</groupId>
          <artifactId>c3p0</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- SMTP notification channels (roadmap Phase 20). -->
    <!-- Managed connectors: the clients the poll cycle and the push step drive themselves
         (roadmap Phase 26, docs/camel-removal.md decision 4). Both arrived under camel-ftp, which
         has now left with the consumers it served; declaring them is the rule that campaign
         learned the hard way, when a departing component took a type converter with it. -->
    <dependency>
      <groupId>com.github.mwiede</groupId>
      <artifactId>jsch</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-net</groupId>
      <artifactId>commons-net</artifactId>
    </dependency>

    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>

    <!-- JDBC driver: bundled for the first milestone; externalized as a driver jar later. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Gated Oracle/SQL Server portability ITs (-Dtesseraql.dialect.its=true). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-oracle-free</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The embedded analytics engine (docs/duckdb.md): test-only here — the driver reaches
         deployments through the module channel, never a compile-scope dependency. -->
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Remote-lake ITs (docs/duckdb.md "Remote data paths") run against Adobe S3Mock —
         the same permissive-license S3-compatible fixture the tesseraql-s3 module uses. -->
    <dependency>
      <groupId>com.adobe.testing</groupId>
      <artifactId>s3mock-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The optional Excel codec, on the test classpath to prove ServiceLoader discovery. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-excel</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-pdf</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- An in-process SFTP server (Apache MINA sshd) for the poll-trigger integration test
         (roadmap Phase 26); no Docker, so it runs anywhere the build does. -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>${sshd.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>${sshd.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.ftpserver</groupId>
      <artifactId>ftpserver-core</artifactId>
      <version>${ftpserver.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          The workshop boundary (docs/studio-shell.md structural decision 3, the guard
          docs/runtime-footprint.md open question 5 asked for): the runtime that every
          deployment carries must never depend on Studio or on a test framework at compile
          or runtime scope. Test scope stays free — a test framework in tests is correct.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-workshop-on-the-runtime</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.tesseraql:tesseraql-studio:*:*:compile</exclude>
                    <exclude>io.tesseraql:tesseraql-studio:*:*:runtime</exclude>
                    <exclude>io.tesseraql:tesseraql-studio-runtime</exclude>
                    <exclude>io.tesseraql:tesseraql-test-core:*:*:compile</exclude>
                    <exclude>io.tesseraql:tesseraql-test-core:*:*:runtime</exclude>
                    <exclude>com.icegreen:greenmail:*:*:compile</exclude>
                    <exclude>com.icegreen:greenmail:*:*:runtime</exclude>
                    <exclude>junit:junit:*:*:compile</exclude>
                    <exclude>junit:junit:*:*:runtime</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            The suite is ~150 independent test classes, most booting their own PostgreSQL
            container and runtime on dynamic ports; run sequentially they dominate the whole
            reactor (11 of 14.5 minutes on CI). One fork per core keeps class-level process
            isolation while running them concurrently. Overridable from the command line
            (-Dsurefire.forkCount=6) to bound load on a shared machine.
          -->
          <forkCount>${surefire.forkCount}</forkCount>
          <reuseForks>true</reuseForks>
          <systemPropertyVariables>
            <!--
              docker-java defaults to an API version (1.32) older than the minimum required by
              recent Docker daemons. Pin a modern, widely supported version for Testcontainers.
            -->
            <api.version>1.43</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
