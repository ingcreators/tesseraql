<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tesseraql</groupId>
    <artifactId>tesseraql-parent</artifactId>
    <version>0.15.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tesseraql-saml</artifactId>
  <name>Tesseraql SAML</name>
  <!--
    SAML 2.0 SP support (design ch. 10.14). XML signature validation uses the JDK's
    javax.xml.crypto.dsig with secure validation enabled; there is no external SAML or
    XML-security dependency, keeping the supply chain on Maven Central only.
  -->

  <dependencies>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- RuntimeExtension SPI + pipeline/yaml, so the SAML SP routes self-install (design ch. 47). -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-compiler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The real outbound gateway, so the metadata-source tests exercise the actual egress
         policy (allow-list denial, status handling) rather than a fake's idea of it. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-operations</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Link-or-provision of local users from SAML assertions (design ch. 10.14 userLink). -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-identity</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!--
          The promotion's guard (docs/module-channel.md decision 2): this module travels with
          every runtime because it is first-party and weightless, so it may declare nothing but
          TesseraQL modules at compile or runtime scope. A third-party dependency added here
          would reach every deployment silently, which is the property the promotion rests on —
          so it fails this module's own build instead. Test scope stays free.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>weightless-on-the-runtime</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>io.tesseraql:*</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                  <searchTransitive>false</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
