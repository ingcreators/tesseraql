<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tesseraql</groupId>
    <artifactId>tesseraql-parent</artifactId>
    <version>0.19.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tesseraql-yaml</artifactId>
  <name>Tesseraql Yaml</name>

  <dependencies>
    <dependency>
      <groupId>org.thymeleaf</groupId>
      <artifactId>thymeleaf</artifactId>
    </dependency>
    <!-- The mail channel's SMTP transport (docs/notifications.md): plain jakarta.mail, the
         same one-sender symmetry as the webhook channel - no message broker in between. -->
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The baked hc email artifacts (docs/notifications.md "HTML mail", upstream brief 9):
         the build unpacks dist/email/default-slate/thymeleaf + contract.json out of the
         WebJar into tesseraql/templates/tql/email/ — nothing generated is checked in, and
         a version bump IS the regen. -->
    <dependency>
      <groupId>org.webjars.npm</groupId>
      <artifactId>hypermedia-components__core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!--
      Quartz's cron expression, without Quartz's scheduler — the runtime's own declaration,
      repeated here for the module boundary's sake (docs/audit-low-leads.md decision 10): a
      job's schedule.cron is judged where it is written by the grammar the scheduler will fire
      it by, so the linter's answer and the boot's are one. A second parser would be a second
      grammar (the two disagree at the edges), and a hand-rolled one a third; the library the
      runtime already carries is the one that cannot drift. The scheduler, its thread pool and
      its JDBC job store are not used, so c3p0 is excluded as the runtime excludes it.
    -->
    <dependency>
      <groupId>org.quartz-scheduler</groupId>
      <artifactId>quartz</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.mchange</groupId>
          <artifactId>c3p0</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- tql/email/* resolves from the classpath exactly as before; the bytes now come
           baked from the core package (dist/email, upstream brief 9) instead of a
           checked-in CLI eject — unpack the WebJar, then copy the default-slate
           thymeleaf flavor and the machine-readable contract into the classpath spot. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-hc-email</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.webjars.npm</groupId>
                  <artifactId>hypermedia-components__core</artifactId>
                  <outputDirectory>${project.build.directory}/hc-core-webjar</outputDirectory>
                  <includes>**/dist/email/default-slate/thymeleaf/*.html,**/dist/email/contract.json</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-hc-email</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/tesseraql/templates/tql/email</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/hc-core-webjar/META-INF/resources/webjars/hypermedia-components__core/${hypermedia-components.version}/dist/email/default-slate/thymeleaf</directory>
                  <includes>
                    <include>*.html</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}/hc-core-webjar/META-INF/resources/webjars/hypermedia-components__core/${hypermedia-components.version}/dist/email</directory>
                  <includes>
                    <include>contract.json</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
