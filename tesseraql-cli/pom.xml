<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tesseraql</groupId>
    <artifactId>tesseraql-parent</artifactId>
    <version>0.15.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tesseraql-cli</artifactId>
  <name>Tesseraql Cli</name>

  <dependencies>
    <!-- The CLI ships the JDK-only structured log provider (roadmap Phase 45), so the
         standalone runtime finally has a real SLF4J backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-yaml</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The MCP dev-tool server (tesseraql mcp) wraps the framework's own surfaces as MCP tools. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-studio</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The workshop extension (docs/studio-shell.md): the developer CLI ships Studio's
         runtime-side machinery; the runtime module itself no longer depends on it. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-studio-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-report</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-coverage-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Shared app-lifecycle tasks behind the package/migrate/identity-schema subcommands, the same
         engine the Maven plugin's mojos use. Brings flyway transitively. -->
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-apptasks</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-operations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tesseraql</groupId>
      <artifactId>tesseraql-security</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The opt-in codec modules (tesseraql-pdf/-excel) are deliberately absent, in every scope:
         an application that uses them declares them in tesseraql.modules, and the CLI resolves
         that declaration into the application's own module cache (docs/module-channel.md
         decision 4). The distribution used to carry their closure as a 'provided' bag under
         modules/, which nothing pointed at and which would have given development a codec the
         deployment does not have. -->
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>

    <!-- Embedded PostgreSQL process supervisor for the serve embedded-db option. The platform
         binary is NOT bundled; it is resolved on demand via the ShrinkWrap resolver below. The
         wildcard exclusion is what makes that sentence true: zonky ships four platform bundles
         transitively at runtime scope (62 MB shipped in every distribution, and a different
         PostgreSQL major than ${zonky.postgres.binaries.version}), and the CLI's unconditional
         custom PgBinaryResolver never reads them (docs/runtime-footprint.md problem 1). The
         test-scoped linux-amd64 declaration below is unaffected: it keeps CI resolution offline.
         The enforcer rule below keeps the bundles out when zonky's tree changes on an upgrade. -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <exclusions>
        <exclusion>
          <groupId>io.zonky.test.postgres</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- PostgreSQL JDBC driver on the CLI runtime classpath. Required directly here, not just
         transitively: zonky's EmbeddedPostgres loads org.postgresql.ds.PGSimpleDataSource to verify
         the embedded-db process is ready, and serve connects to (embedded or external) PostgreSQL
         through it. Declared explicitly at compile scope so the dist fat jar bundles it regardless of
         whether tesseraql-runtime keeps shipping the driver transitively. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- Embedded Maven artifact resolver for the opt-in tesseraql.modules set: resolves
         coordinates (versions from the BOM) into the module cache the plugin classloader loads,
         reusing ~/.m2/settings.xml so corporate proxies/mirrors apply. No Maven install needed. -->
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-api-maven</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jboss.shrinkwrap.resolver</groupId>
      <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The database-backed subcommand ITs run against PostgreSQL via Testcontainers. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The current CI/devcontainer platform's PostgreSQL binary, so the embedded-db IT resolves it
         offline from the local repository. Resolution detects the running platform at runtime; on
         other platforms the resolver falls back to the network. -->
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
      <version>${zonky.postgres.binaries.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- embedded-postgres.properties is filled from ${zonky.postgres.binaries.version} so the
           embedded-db binary version is single-sourced from the reactor. -->
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!--
          The boundary's guard (docs/runtime-footprint.md decision 5, the pattern from
          tesseraql-runtime's no-workshop-on-the-runtime): embedded PostgreSQL binaries are
          resolved on demand, never bundled, so no platform bundle may reach the CLI's compile or
          runtime scope — that is how 62 MB of dead-weight binaries shipped in every distribution
          once. Test scope stays free: the declared linux-amd64 test dependency is what keeps CI
          resolution off the network.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-bundled-database-binaries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.zonky.test.postgres:*:*:*:compile</exclude>
                    <exclude>io.zonky.test.postgres:*:*:*:runtime</exclude>
                  </excludes>
                  <searchTransitive>true</searchTransitive>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The installable CLI distribution (activate with -Pdist): a self-contained executable fat
         jar plus launcher scripts, zipped/tarred. Kept out of normal builds so the everyday
         compile/verify loop stays fast; the release workflow and the dist CI job activate it. -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <!-- Self-contained executable fat jar (tesseraql-cli-<version>-all.jar): the base runtime
               + embedded resolver, runnable as `java -jar` with no install. The opt-in pdf/excel
               codecs are absent: they load from an application's own resolved module cache. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.2</version>
            <executions>
              <execution>
                <id>cli-fatjar</id>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <shadedArtifactAttached>true</shadedArtifactAttached>
                  <shadedClassifierName>all</shadedClassifierName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                        <exclude>module-info.class</exclude>
                        <exclude>META-INF/versions/*/module-info.class</exclude>
                      </excludes>
                    </filter>
                  </filters>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>io.tesseraql.cli.TesseraqlCli</mainClass>
                    </transformer>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  </transformers>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- Zip/tar the fat jar and the launcher scripts into a portable distribution archive
               (tesseraql-cli-<version>-dist.zip / .tar.gz). -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>3.8.0</version>
            <executions>
              <execution>
                <id>cli-dist</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <appendAssemblyId>true</appendAssemblyId>
                  <descriptors>
                    <descriptor>src/assembly/dist.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
