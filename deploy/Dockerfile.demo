# The five-minute demo image (roadmap Phase 47): one container that boots a browsable
# gallery app with Studio open — embedded PostgreSQL inside the container, migrations
# auto-seed the data, no compose and no external database.
#
#   docker build -f deploy/Dockerfile.demo --build-arg APP_HOME=examples/inventory-app -t tesseraql-demo .
#   docker run --rm -p 8080:8080 tesseraql-demo
#   open http://localhost:8080/inventory/_tesseraql/studio
#
# The embedded PostgreSQL binary resolves on first boot (network needed once); the pgdata
# volume keeps the seeded data across restarts. This image is for demos and evaluation —
# production deploys use deploy/Dockerfile with a real database (docs/deployment.md).

FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /src
COPY . .
# install (not package): the second invocation resolves the reactor's own modules
# from the container-local repository - package alone leaves them unresolvable and
# copy-dependencies fails on the io.tesseraql:* coordinates.
RUN ./mvnw -B -ntp -pl tesseraql-cli -am -DskipTests install \
    && ./mvnw -B -ntp -pl tesseraql-cli dependency:copy-dependencies -DoutputDirectory=target/dependency -DskipTests

FROM eclipse-temurin:25-jre
RUN useradd --system --create-home tesseraql
WORKDIR /home/tesseraql
COPY --from=build /src/tesseraql-cli/target/*.jar lib/
COPY --from=build /src/tesseraql-cli/target/dependency/*.jar lib/
ARG APP_HOME=examples/inventory-app
COPY ${APP_HOME} /stack/app
RUN mkdir -p /stack/app/work && chown -R tesseraql /stack
# The same build-time class-data-sharing archive as the production image
# (docs/jvm-baseline.md decision 4). It matters more here: the demo image is judged on how
# quickly it comes up.
# Same flags as the ENTRYPOINT: an archive trained under a different UseCompactObjectHeaders
# setting is refused by the JVM that reads it.
RUN java -XX:+UseCompactObjectHeaders \
      -XX:+AutoCreateSharedArchive -XX:SharedArchiveFile=/home/tesseraql/lib/cds.jsa \
      -cp 'lib/*' io.tesseraql.cli.TesseraqlCli routes --app /stack/app > /dev/null 2>&1 \
      && chown tesseraql /home/tesseraql/lib/cds.jsa \
    || echo 'CDS training run failed; this image starts without a shared archive'
USER tesseraql
VOLUME /stack/app/work
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=90s \
  CMD curl -fsS http://localhost:8080/_tesseraql/health/live || exit 1
ENTRYPOINT ["java", \
  "-XX:+UseCompactObjectHeaders", \
  "--sun-misc-unsafe-memory-access=allow", \
  "-XX:SharedArchiveFile=/home/tesseraql/lib/cds.jsa", \
  "-cp", "lib/*", "io.tesseraql.cli.TesseraqlCli"]
CMD ["dev", "--stack", "/stack", "--embedded-db", "/stack/app/work/pgdata", "--port", "8080"]
